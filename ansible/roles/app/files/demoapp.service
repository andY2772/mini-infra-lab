[Unit]
Description=Demo web app
After=network.target

[Service]
User=demoapp
Group=demoapp
WorkingDirectory=/opt/demoapp
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
